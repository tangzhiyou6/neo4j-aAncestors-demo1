// =============================================================================
// 清空当前 Neo4j 库的所有实体与关系
// 环境（来自截图）：AuraDB 实例 test-db · Database: neo4j · Cypher 25
// 说明：本脚本按"从确认 → 清空 → 校验"三步组织，按需执行对应章节。
//
// ⚠️ 不可逆操作，执行前确认：
//    1) 右上角 Database 选的是 neo4j（截图里就是这个，别选成 system）
//    2) AuraDB 没有文件系统访问，物理级清空（删 data/databases 目录）不适用
// =============================================================================


// =============================================================================
// 〇、前置：确认连接到正确的数据库
// -----------------------------------------------------------------------------
// 下面是 Neo4j Browser 的元命令（不是 Cypher），直接在输入框敲：
// =============================================================================
// :use neo4j
// :sysinfo          // 看实例与各库占用


// =============================================================================
// 一、先看清库里到底有什么（可选，建议先跑一遍）
// =============================================================================

// 1.1 数据量（这两个数字才代表真实数据；左侧 Overview 的标签/属性键列表不算）
MATCH (n) RETURN count(n) AS `节点总数`;
MATCH ()-[r]->() RETURN count(r) AS `关系总数`;

// 1.2 都是谁（如果有数据，看清楚是哪些标签在占地方）
MATCH (n)
RETURN labels(n) AS `标签`, count(*) AS `数量` ORDER BY `数量` DESC;
MATCH ()-[r]->()
RETURN type(r) AS `关系类型`, count(*) AS `数量` ORDER BY `数量` DESC;

// 1.3 存储中的令牌（即使数据为 0 也可能列出历史名字，这是正常的）
// CALL db.labels()        YIELD label  RETURN label;
// CALL db.relationshipTypes() YIELD relationshipType RETURN relationshipType;
// CALL db.propertyKeys()  YIELD propertyKey RETURN propertyKey;


// =============================================================================
// 二、清空所有实体与关系 —— 核心命令
// -----------------------------------------------------------------------------
// DETACH DELETE 会先删掉节点上的所有关系，再删节点本身，
// 一条语句即可同时清空"实体 + 边"，不存在删除顺序问题。
// =============================================================================
MATCH (n) DETACH DELETE n;


// =============================================================================
// 三、只想删一种情况时的细分写法（按需选用）
// =============================================================================

// 3.1 只删边，保留所有节点
// MATCH ()-[r]->() DELETE r;

// 3.2 只删某类标签的节点（及其关系）
// MATCH (n:GraphNode) DETACH DELETE n;

// 3.3 清掉 Bloom 残留的透视表/场景节点（如果它们存在于业务库中）
// MATCH (n) WHERE n:_Bloom_Perspective_ OR n:_Bloom_Scene_ DETACH DELETE n;


// =============================================================================
// 四、数据量大时的分批删除（AuraDB Free 上限 20 万节点，一般用不到；
//     但如果以后迁移到更大的实例，请改用这段，避免单事务过大）
// -----------------------------------------------------------------------------
// Cypher 25 推荐写法（变量作用域子查询）。必须在自动提交事务中执行，
// Neo4j Browser / cypher-shell 直接跑即可，不能包在 BEGIN...COMMIT 里。
// =============================================================================
// MATCH (n)
// CALL (n) { DETACH DELETE n } IN TRANSACTIONS OF 10000 ROWS;

// 兼容老版本（Neo4j 5.22 及更早）的等价写法：
// MATCH (n)
// CALL { WITH n DETACH DELETE n } IN TRANSACTIONS OF 10000 ROWS;

// 安装了 APOC 的话也可以：
// CALL apoc.periodic.iterate('MATCH (n) RETURN n', 'DETACH DELETE n',
//                            {batchSize: 10000, parallel: false})
// YIELD batches, total RETURN batches, total;


// =============================================================================
// 五、清空后校验（三个都应返回 0）
// =============================================================================
// 期望 0
MATCH (n) RETURN count(n) AS `节点总数`;
// 期望 0
MATCH ()-[r]->() RETURN count(r) AS `关系总数`;

// 顺带清一下查询计划缓存（可选）
// CALL db.clearQueryCaches();


// =============================================================================
// 六、如果连"残留的标签名 / 属性键名"也想彻底清掉
// -----------------------------------------------------------------------------
// 这些是元数据令牌，删数据不会回收，只有重建数据库才能清干净：
//
// · AuraDB（你当前环境）：Free 版不支持 DROP DATABASE，也无法停库删文件。
//   彻底干净的做法是新建一个 AuraDB 实例（或删掉重建 test-db），数据为空时
//   成本很低；实例上的 token 会随实例一起消失。
//
// · 本地 / 自建 Neo4j：停库后删除数据文件再启动
//     bin/neo4j stop
//     rm -rf data/databases/neo4j data/transactions/neo4j
//     bin/neo4j start
//
// · Enterprise 版：STOP DATABASE neo4j;  DROP DATABASE neo4j;  CREATE DATABASE neo4j;
//
// 一般情况下不必这么做 —— token 只是名字，不占多少空间，也不影响建图。
// =============================================================================
